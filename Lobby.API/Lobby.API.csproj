        <RootNamespace>AerAdvance.LobbyApi</RootNamespace>

    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AerAdvance.ServiceDefaults\AerAdvance.ServiceDefaults.csproj"/>
